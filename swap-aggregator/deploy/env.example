# Runtime stack variables. Keep real values outside source control and build contexts.
# Immutable release reference obtained AFTER an authorized registry publication.
HERMES_IMAGE=registry.example/hermes:release-id@sha256:REPLACE_WITH_VERIFIED_DIGEST
HERMES_PUBLIC_ORIGIN=https://hermes.example
HERMES_TRUST_PROXY=false
HERMES_EXECUTION_DISABLED=true
HERMES_API_LOGS=false
LIFI_API_KEY=
RANGO_API_KEY=
RANGO_REFERRER_ADDRESS=
NEAR_1CLICK_API_KEY=
NEAR_1CLICK_JWT=
TOKEN_SEARCH_REQUESTS_PER_MINUTE=60
LIFI_SERVER_REQUESTS_PER_MINUTE=120
CG_API_KEY=
CG_API_TIER=demo
CMC_API_KEY=
TOP_ASSET_PRIMARY_PROVIDER=coingecko
TOP_ASSET_FETCH_LIMIT=120
TARGET_UNIVERSE_SIZE=100
# BUILD ONLY, recorded in the image labels; do not add these to runtime to change an image:
# NEXT_PUBLIC_RELEASE_MODE=quotes
# NEXT_PUBLIC_PLATFORM_FEE_PERCENT=0
# HERMES_SOURCE_REVISION=<commit and tree evidence reference>
