# Clé projet WalletConnect (gratuite sur cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optionnel : clé API LI.FI si tu dépasses le tier gratuit
NEXT_PUBLIC_LIFI_API_KEY=

# Frais plateforme Hermes en pourcentage (0 = désactiver les fees)
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=0

# Optionnel : clé partenaire 1Click, uniquement côté serveur (ne jamais préfixer NEXT_PUBLIC_)
NEAR_1CLICK_API_KEY=
