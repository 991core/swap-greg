# Optionnel : clé LI.FI privée, uniquement pour l'API serveur des tokens.
# Les cotations/exécutions du navigateur n'utilisent pas cette clé.
LIFI_API_KEY=

# Profil public livré : cotations seules. 'enabled' nécessite une nouvelle image
# après qualification financière ; 'incident' bloque les nouvelles émissions.
NEXT_PUBLIC_RELEASE_MODE=quotes
# Coupe les émissions dans une image enabled au redémarrage, sans couper le suivi.
HERMES_EXECUTION_DISABLED=true
# Origine HTTPS canonique du site derrière le reverse proxy ; à renseigner au déploiement.
HERMES_PUBLIC_ORIGIN=
# N'activer que derrière un proxy de confiance configuré par l'opérateur.
HERMES_TRUST_PROXY=false
HERMES_API_LOGS=false

# Appels LI.FI du service tokens par minute et par instance (1-1000).
TOKEN_SEARCH_REQUESTS_PER_MINUTE=60
# Budget LI.FI serveur partagé entre recherche et univers de marché, par instance.
LIFI_SERVER_REQUESTS_PER_MINUTE=120

# Frais plateforme Hermes en pourcentage (0 = désactiver les fees)
NEXT_PUBLIC_PLATFORM_FEE_PERCENT=0

# Optional private Rango key. Empty uses Rango's documented public TEST key
# and public-api.rango.exchange. Test key has low quotas; not for production.
# This is NOT a testnet: signing spends real mainnet funds.
RANGO_API_KEY=
# Required if platform fee > 0 (Rango supports at most 3%). EVM recipient.
RANGO_REFERRER_ADDRESS=

# Optional: used for EUR display conversion. The app falls back to USD if unavailable.
# No API key is required.

# 1Click / NEAR Intents (server-only)
NEAR_1CLICK_API_KEY=
NEAR_1CLICK_JWT=

# Token market discovery / independent identity metadata. Server-only keys.
CG_API_KEY=
CG_API_TIER=demo
CMC_API_KEY=
TOP_ASSET_PRIMARY_PROVIDER=coingecko
TOP_ASSET_FETCH_LIMIT=120
TARGET_UNIVERSE_SIZE=100
TOKEN_CONSENSUS_REQUIRED_SOURCES=3
# This flag changes candidate quorum only; onboarding always needs explicit approval.
ALLOW_TWO_OF_THREE_ON_INITIAL_ONBOARDING=false
SUPPORTED_CHAIN_IDS=[8453,1,42161,10,137,56,43114,100,1088]
MAX_SLIPPAGE_BPS=100
# Legacy standalone validation policies; unused by swap execution.
# Empty lists only block calls to the standalone security validation API.
LIFI_ALLOWED_CONTRACTS=[]
ALLOWED_APPROVAL_TARGETS=[]
ALLOWED_DEPOSIT_RECEIVERS=[]
# Diagnostic/discovery registry and audit; never include these files in Git.
TOKEN_REGISTRY_PATH=.hermes-security/trusted-tokens.json
TOKEN_CONFLICT_LOG_PATH=.hermes-security/security-events.json
# Archive-policy hint in days. Audit records are never deleted automatically.
TOKEN_CONFLICT_LOG_RETENTION=365
